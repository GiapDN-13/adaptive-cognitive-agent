# Provider: "gemini" or "bedrock"
LLM_PROVIDER=bedrock

# Gemini settings (if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# AWS Bedrock settings (if LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
BEDROCK_LIGHT_MODEL=us.anthropic.claude-sonnet-4-6-v1
BEDROCK_HEAVY_MODEL=us.anthropic.claude-opus-4-6-v1
